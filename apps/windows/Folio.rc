#include <windows.h>

1 ICON "../../Shared/Resources/Folio.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Folio - local Markdown editor"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductName", "Folio"
            VALUE "ProductVersion", "0.1.0"
            VALUE "OriginalFilename", "Folio.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
