{
  "name": "@folio/editor",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./helpers": "./src/editor-helpers.ts",
    "./markdown": "./src/markdown.ts",
    "./math": "./src/math.ts",
    "./roundtrip": "./src/roundtrip.ts",
    "./source": "./src/source-editor.ts"
  },
  "scripts": {
    "benchmark:math-cache": "npm run build --silent && tsx benchmarks/cache-math.ts",
    "benchmark:math-edit": "npm run build --silent && tsx benchmarks/edit-math.ts",
    "benchmark:math": "npm run build --silent && tsx benchmarks/live-math.ts",
    "benchmark:source-prepare": "npm run build --silent && tsx benchmarks/source-prepare.ts",
    "build": "npm run check:types && tsx build.ts",
    "check:types": "tsc --project tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@lezer/cpp": "1.1.6",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/javascript": "1.5.4",
    "@lezer/markdown": "1.7.2",
    "@lezer/rust": "1.0.2",
    "@milkdown/core": "7.22.1",
    "@milkdown/ctx": "7.22.1",
    "@milkdown/plugin-history": "7.22.1",
    "@milkdown/preset-commonmark": "7.22.1",
    "@milkdown/preset-gfm": "7.22.1",
    "@milkdown/prose": "7.22.1",
    "@milkdown/transformer": "7.22.1",
    "@milkdown/utils": "7.22.1",
    "entities": "8.1.0",
    "diff": "9.0.0",
    "katex": "0.18.7",
    "overlayscrollbars": "2.16.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-wiki-link": "2.0.1",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/unist": "3.0.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "vfile": "6.0.3"
  }
}
